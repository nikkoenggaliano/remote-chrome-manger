# ============================================================================
# Chrome Fleet Control — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values, then start with ./run.sh
#   cp .env.example .env
# run.sh will also auto-create .env from this file on first launch if missing.
# ============================================================================

# --- Authentication (REQUIRED) ----------------------------------------------
# Basic-Auth credentials for the dashboard UI and the legacy /api/* endpoints.
# The server refuses to start if either of these is empty.
CHROME_FLEET_USERNAME=admin
CHROME_FLEET_PASSWORD=secret

# --- Server ------------------------------------------------------------------
# Port the dashboard/HTTP server listens on (binds 0.0.0.0).
PORT=3000

# --- REST API (optional) -----------------------------------------------------
# When REST_API=true, the token-protected API is mounted under /rest/*.
# REST_API_KEY is REQUIRED whenever REST_API=true (sent as X-API-Key or
# "Authorization: Bearer <key>").
REST_API=false
REST_API_KEY=super-secret-key

# --- Launcher / daemon (run.sh) ---------------------------------------------
# RUN_IN_SCREEN=true detaches the server into a GNU screen session.
# SESSION_NAME is the screen session name. AUTO_INSTALL lets prep.sh try to
# install missing system dependencies automatically.
RUN_IN_SCREEN=false
SESSION_NAME=chrome-fleet
AUTO_INSTALL=false

# --- Browser launch behaviour ------------------------------------------------
# POP_UP_REAL_BROWSER=true forces every local instance to launch a visible GUI
# browser. When false/unset, each instance honours its own launch_mode
# (gui / xvfb / chrome_headless) chosen in the UI.
POP_UP_REAL_BROWSER=false

# Absolute path (or command on PATH) to the Chrome/Chromium binary. If left
# unset the app auto-detects common install locations per OS. Seeds the
# "chrome_bin" config row on first run.
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=/usr/bin/google-chrome-stable

# --- Node binary (run.sh) ----------------------------------------------------
# Override which node binary run.sh uses. Leave unset to auto-resolve from PATH
# and common Homebrew/system locations.
# NODE_BIN=/opt/homebrew/opt/node@22/bin/node

# --- Live tab control tuning -------------------------------------------------
# JPEG quality (10-100) of the streamed screenshots. Higher = sharper but
# larger frames. Defaults to 60.
# SCREENSHOT_QUALITY=60

# --- Advanced Chrome flags (optional) ---------------------------------------
# Enable WebGL-friendly GPU flags. run.sh sets this to 1 by default; set to 0
# to fall back to --disable-gpu.
# CHROME_MANAGER_ENABLE_WEBGL=1

# On macOS, GUI instances launch via `open` by default. Set to 0 to spawn the
# Chrome binary directly instead.
# CHROME_MANAGER_DARWIN_USE_OPEN=1

# Legacy global headless toggles (per-instance launch_mode now takes priority).
# CHROME_MANAGER_FORCE_HEADLESS=0
# CHROME_MANAGER_DARWIN_HEADLESS=0
